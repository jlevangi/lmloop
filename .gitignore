__pycache__/
*.pyc

# Build artefacts from `pip install .`; the source is the flat modules at the
# repo root, and these are regenerated on demand.
build/
dist/
*.egg-info/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local issue tracker: bd data, config and hooks stay on this machine.
.beads/

# Session handoffs. Scaffolding for whoever picks the work up next, not part
# of the project -- and this repository is public, so a file describing one
# person's machine and workflow does not belong in it.
.claude/*HANDOFF*.md
