# Copy to ~/.config/lmloop/web.env.  `lmloop web` loads it without overriding
# anything already set in the environment.

# Where to look for projects.  Colon-separated; repositories one level below.
LMLOOP_WEB_ROOTS=$HOME/git

LMLOOP_WEB_HOST=127.0.0.1
LMLOOP_WEB_PORT=8082

# --- Who may drive it -------------------------------------------------------
#
# The dashboard starts and stops agents, deletes archives and opens pull
# requests, so binding anything but loopback needs an identity boundary.
# Without one it refuses to bind, whichever mode you are in.
#
#   none    nobody is asked; loopback only.  The default, and right for a
#           laptop -- reach it over an SSH tunnel.
#   proxy   an ingress in front already authenticated the request and says who
#           it was in a header.  oauth2-proxy, Authelia, Cloudflare Access, an
#           nginx auth_request.
#   oidc    the dashboard runs the login itself, against any OIDC issuer.
#
# Left unset, the mode is inferred: `oidc` if the OIDC settings below are
# filled in, `none` otherwise.
#LMLOOP_WEB_AUTH_MODE=proxy

# --- proxy mode -------------------------------------------------------------
# A header is only evidence if nothing else can set it.  The header is read
# ONLY from these addresses; anyone else sending it is anonymous however they
# decorate the request.  Setting the mode without this list is refused.
#LMLOOP_WEB_TRUSTED_PROXIES=127.0.0.1,10.0.0.5
#LMLOOP_WEB_PROXY_HEADER=X-Forwarded-User        # oauth2-proxy: X-Auth-Request-User
#LMLOOP_WEB_PROXY_NAME_HEADER=X-Forwarded-Name   # optional, for display only
#LMLOOP_WEB_HOST=0.0.0.0

# --- oidc mode --------------------------------------------------------------
# Generic OIDC discovery; any issuer.  Needs two libraries, installed for the
# interpreter that runs the server:
#   python3 -m pip install "PyJWT[crypto]>=2.7,<3" "requests>=2.31,<3"
# The two secrets accept a reference instead of a value -- `env:NAME`,
# `file:PATH` or `!command`; see config.secret.
#LMLOOP_WEB_HOST=0.0.0.0
#LMLOOP_WEB_PUBLIC_URL=https://lmloop.example.com
#LMLOOP_WEB_OIDC_ISSUER=https://sso.example.com/realms/main
#LMLOOP_WEB_OIDC_CLIENT_ID=lmloop-web
#LMLOOP_WEB_OIDC_CLIENT_SECRET=file:/run/secrets/lmloop-oidc
#LMLOOP_WEB_SESSION_SECRET=!openssl rand -hex 32

# --- Defaults offered in the new-run sheet ----------------------------------
# Which agent to ask for the model list.  The dashboard offers what that agent
# actually lists; it invents nothing of its own.
LMLOOP_WEB_HARNESS=pi
# Empty offers only what the agent lists.  Set it to preselect one.
LMLOOP_WEB_DEFAULT_MODEL=
LMLOOP_WEB_DEFAULT_MAX_ITERATIONS=20
LMLOOP_WEB_DEFAULT_THINKING=low

# Serve the views, refuse every control.
LMLOOP_WEB_READ_ONLY=false

# --- Device tokens (read-only) -----------------------------------------------
#
# For a client with no cookie jar of its own -- a native app's background
# service, a periodic job -- not for a browser. Comma-separated label=reference
# pairs; each reference accepts env:/file:/!command or a literal, same as any
# other secret in this project. These can never start, stop, pause, archive,
# delete or PR a run: `/api/*` GETs only, by construction, not by a flag.
# Generate one per device with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#LMLOOP_WEB_DEVICE_TOKENS=phone=env:LMLOOP_DEVICE_TOKEN_PHONE,tablet=file:/run/secrets/lmloop-tablet-token

# --- Web Push (VAPID) --------------------------------------------------------
#
# Lets a subscribed browser get a native push when a run finishes, straight
# from the platform's own push service -- independent of, and in addition to,
# ntfy's [notify] mechanism. Needs `pywebpush`:
#   python3 -m pip install "pywebpush>=2.0,<3"
# Generate a key pair once and keep the private half out of this file:
#   python3 -c "from py_vapid import Vapid01; v = Vapid01(); v.generate_keys(); print(v.private_pem().decode())"
#LMLOOP_WEB_VAPID_PRIVATE_KEY=file:/run/secrets/lmloop-vapid-key
#LMLOOP_WEB_VAPID_CONTACT=mailto:you@example.com
# Where subscriptions are stored. Defaults to ~/.config/lmloop/push_subscriptions.json.
#LMLOOP_WEB_PUSH_STORE=$HOME/.config/lmloop/push_subscriptions.json
