# Copy to ~/.config/lmloop/web.env.  `lmloop web` loads it without overriding
# anything already set in the environment.

# Where to look for projects.  Colon-separated; repositories one level below.
LMLOOP_WEB_ROOTS=$HOME/git

LMLOOP_WEB_HOST=127.0.0.1
LMLOOP_WEB_PORT=8082

# Binding anything but loopback requires the OIDC settings below -- the
# dashboard can start and stop agents, so it does not go on a network without a
# sign-in.  Install its two dependencies for the interpreter that runs it:
#   /usr/bin/python3 -m pip install "PyJWT[crypto]>=2.7,<3" "requests>=2.31,<3"
#LMLOOP_WEB_HOST=0.0.0.0
#LMLOOP_WEB_PUBLIC_URL=https://lmloop.example.com
#LMLOOP_WEB_OIDC_ISSUER=https://sso.example.com/realms/main
#LMLOOP_WEB_OIDC_CLIENT_ID=lmloop-web
#LMLOOP_WEB_OIDC_CLIENT_SECRET=
#LMLOOP_WEB_SESSION_SECRET=

# Defaults offered in the new-run sheet.
LMLOOP_WEB_DEFAULT_MODEL=llama-swap/local-fast
LMLOOP_WEB_DEFAULT_MAX_ITERATIONS=20
LMLOOP_WEB_DEFAULT_THINKING=low

# Serve the views, refuse every control.
LMLOOP_WEB_READ_ONLY=false
